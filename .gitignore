# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.DS_Store
.superpowers/
.playwright-mcp/

# Claude Code — local-only settings
.claude/settings.local.json
.claude/worktrees/

# Generated CV / cover-letter PDFs (regenerable from HTML via docs/cv/export-pdf.mjs)
# Source-of-truth HTML stays tracked; input PDFs in docs/cv/data/ stay tracked.
/docs/cv/*.pdf
